{
  "hosting": [
    {
      "target": "landing",
      "public": "frontend/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/r/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/webhook{,/**}",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/payment/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "target": "app",
      "public": "frontend/out-app",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/r/**",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/health",
          "run": {
            "serviceId": "yell-ai-api",
            "region": "asia-south1"
          }
        },
        {
          "source": "/brands",
          "destination": "/brands.html"
        },
        {
          "source": "/ads",
          "destination": "/ads.html"
        },
        {
          "source": "/**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
