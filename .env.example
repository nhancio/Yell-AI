# Frontend auth
DATABASE_URL=file:./dev.db
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=***
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_g…cret

# Optional frontend/server defaults for the managed NanoClaw deploy flow
YELLAI_ANTHROPIC_API_KEY=
YELLAI…KEN=

# WhatsApp (Meta Cloud API)
# App secret from developers.facebook.com → App settings → Basic.
# Inbound webhooks are REJECTED unless their X-Hub-Signature-256 verifies with it.
WHATSAPP_APP_SECRET=

# WhatsApp Phone Number ID (Meta → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Meta access token + webhook verify token
WHATSAPP_TOKEN=your_w…oken
WHATSAPP_VERIFY_TOKEN=your_w…oken

# Google Gemini API
GEMINI_API_KEY=your_g…_key

# Redis (Docker maps host 6380 → container 6379; avoids Homebrew Redis on 6379)
REDIS_URL=redis://localhost:6380

# Backend PostgreSQL example (Docker maps host 5433 → container 5432; avoids Homebrew Postgres on 5432)
BACKEND_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/yellai

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_r…cret

# Razorpay dashboard webhook secret (falls back to RAZORPAY_KEY_SECRET; blank = webhooks rejected)
RAZORPAY_WEBHOOK_SECRET=

# Admin API (/admin/*): refuses every request until set to a long random value
ADMIN_API_KEY=

# Usage Limits
FREE_DAILY_LIMIT=10
PAID_DAILY_LIMIT=40
MONTHLY_PRICE_PAISE=90000

# Composio (https://app.composio.dev — 1-Tap OAuth Connectors for Gmail, Calendar, Notion, GitHub)
COMPOSIO_API_KEY=your_composio_api_key
# JSON mappings. CRM IDs come from your Composio project's auth configurations.
# An empty string disables an existing connector. Set callback origins below for local dev.
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3
COMPOSIO_AUTH_CONFIGS={}
COMPOSIO_TOOL_VERSIONS={}
APP_FRONTEND_URL=http://localhost:3000/app
ADS_ENABLED=false
FRONTEND_URL=https://yell.nhancio.com
