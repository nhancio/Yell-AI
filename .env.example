# Frontend auth
DATABASE_URL=file:./dev.db
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional frontend/server defaults for the managed NanoClaw deploy flow
YELLAI_ANTHROPIC_API_KEY=
YELLAI_CLAUDE_CODE_OAUTH_TOKEN=

# WhatsApp Provider: "kapso" (recommended) or "meta"
WHATSAPP_PROVIDER=kapso

# Kapso AI (https://kapso.ai — get API key from Project Settings)
KAPSO_API_KEY=your_kapso_api_key

# WhatsApp Phone Number ID (from Kapso dashboard or Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Meta Direct (only needed if WHATSAPP_PROVIDER=meta)
WHATSAPP_TOKEN=your_whatsapp_api_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Redis (Docker maps host 6380 → container 6379; avoids Homebrew Redis on 6379)
REDIS_URL=redis://localhost:6380

# Backend PostgreSQL example (Docker maps host 5433 → container 5432; avoids Homebrew Postgres on 5432)
BACKEND_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/yellai

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Usage Limits
FREE_DAILY_LIMIT=10
PAID_DAILY_LIMIT=1000
MONTHLY_PRICE_PAISE=90000
